# ---------------------------------------------------------------- data
# Raw and derived data are reproducible from scripts/download_data.py and the
# pipeline; keeping 400 MB of .mat files in git would be a mistake.
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep

# ------------------------------------------------------- run artifacts
# Regenerated by `python scripts/run_pipeline.py`. Figures and reports ARE
# tracked (see negations below) because they are the deliverable a reader wants
# to see without running anything.
models/**
!models/.gitkeep
reports/pipeline.log

# Milestone 2 model bundles: pickled estimators regenerated by
# `python -m battery_rul.pipelines.run_milestone_2`. The *metadata* is the
# reviewable part and is kept, so a reader can see the feature schema,
# fingerprints and training configuration without a 3 MB pickle in git.
artifacts/*/*
!artifacts/*/metadata.json
!artifacts/.gitkeep

# ------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# -------------------------------------------------------------- tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/
.hypothesis/

# ------------------------------------------------------------ optuna
*.db
*.db-journal

